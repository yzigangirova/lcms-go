func TestComputeKToLstar_Sanity(t *testing.T) {
    cmyk := CmsCreateCMYKProfile()
    defer CmsCloseProfile(cmyk)

    curve := ComputeKToLstar(nil, 17, 1,
        []uint32{INTENT_RELATIVE_COLORIMETRIC},
        []CmsHPROFILE{cmyk},
        []bool{true},
        []float64{1.0},
        0)

    if curve == nil {
        t.Errorf("ComputeKToLstar failed")
    } else {
        CmsFreeToneCurve(curve)
    }
}

