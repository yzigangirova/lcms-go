func TestCmsDetectRGBProfileGamma_SRGB(t *testing.T) {
    p := CmsCreate_sRGBProfile()
    defer CmsCloseProfile(p)

    gamma := cmsDetectRGBProfileGamma(p, 0.01)
    if gamma <= 0 {
        t.Errorf("cmsDetectRGBProfileGamma failed: %f", gamma)
    }
}

func TestEstimateTAC_BasicCallback(t *testing.T) {
    // A fake transform would be needed to run fully.
    est := &cmsTACestimator{
        nOutputChans: 4,
        MaxTAC:       0,
    }

    in := make([]uint16, 4)
    out := make([]uint16, 1)
    EstimateTAC(in, out, est)
}
func TestGamutSampler_InGamut(t *testing.T) {
    chain := &GAMUTCHAIN{
        Threshold: 10.0,
        hInput:    nil,
        hForward:  nil,
        hReverse:  nil,
    }

    // Simulate LabIn == LabOut
    in := make([]uint16, 3)
    out := make([]uint16, 1)

    // For a fully mocked transform, skip real transforms
    GamutSampler(in, out, chain)

    if out[0] != 0 {
        t.Errorf("Expected in-gamut result (0), got %d", out[0])
    }
}

func TestCmsCreateGamutCheckPipeline_SRGB(t *testing.T) {
    h := CmsCreate_sRGBProfile()
    defer CmsCloseProfile(h)

    p := cmsCreateGamutCheckPipeline(nil,
        []CmsHPROFILE{h},
        []bool{false},
        []uint32{INTENT_RELATIVE_COLORIMETRIC},
        []float64{1.0},
        1,
        h,
    )

    if p == nil {
        t.Errorf("cmsCreateGamutCheckPipeline returned nil")
    } else {
        cmsPipelineFree(p)
    }
}

func TestCmsCreateGamutCheckPipeline_InvalidPCS(t *testing.T) {
    h := CmsCreate_sRGBProfile()
    defer CmsCloseProfile(h)

    p := cmsCreateGamutCheckPipeline(nil,
        []CmsHPROFILE{h},
        []bool{false},
        []uint32{INTENT_RELATIVE_COLORIMETRIC},
        []float64{1.0},
        0, // invalid PCS
        h,
    )

    if p != nil {
        t.Errorf("Expected nil pipeline with invalid PCS, got non-nil")
    }
}

