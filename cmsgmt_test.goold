func TestCmsCreateGamutCheckPipeline_FailsOnMatrixProfile(t *testing.T) {
    p := CmsCreateXYZProfile()
    defer CmsCloseProfile(p)

    x := cmsCreateGamutCheckPipeline(nil,
        []CmsHPROFILE{p},
        []bool{false},
        []uint32{INTENT_RELATIVE_COLORIMETRIC},
        []float64{1.0},
        1,
        p,
    )

    if x == nil {
        t.Log("cmsCreateGamutCheckPipeline gracefully failed on XYZ")
    }
}
